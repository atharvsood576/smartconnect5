{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/plans",
      "destination": "/portal.html"
    },
    {
      "source": "/login",
      "destination": "/portal.html"
    },
    {
      "source": "/account",
      "destination": "/portal.html"
    },
    {
      "source": "/checkout",
      "destination": "/portal.html"
    },
    {
      "source": "/admin",
      "destination": "/portal.html"
    },
    {
      "source": "/terms",
      "destination": "/portal.html"
    },
    {
      "source": "/reset-password",
      "destination": "/portal.html"
    },
    {
      "source": "/editor",
      "destination": "/index.html"
    },
    {
      "source": "/scan.html",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/portal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://eezljofhwbohqundogjk.supabase.co wss://eezljofhwbohqundogjk.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
